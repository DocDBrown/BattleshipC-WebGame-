<div class="placement">
    <div class="placement-toolbar">
        <div class="segmented" role="group" aria-label="Placement mode">
            <button type="button"
                    class="@(Mode == PlacementMode.Manual ? "active" : string.Empty)"
                    aria-pressed="@(Mode == PlacementMode.Manual)"
                    @onclick="() => Mode = PlacementMode.Manual">
                Manual
            </button>
            <button type="button"
                    class="@(Mode == PlacementMode.Automatic ? "active" : string.Empty)"
                    aria-pressed="@(Mode == PlacementMode.Automatic)"
                    @onclick="() => Mode = PlacementMode.Automatic">
                Automatic
            </button>
        </div>

        @if (Mode == PlacementMode.Manual)
        {
            <button type="button" class="btn ghost" @onclick="Rotate">
                Rotate: @(Horizontal ? "Horizontal" : "Vertical")
            </button>
            <button type="button" class="btn ghost" @onclick="Reset">Reset</button>
        }
        else
        {
            <button type="button" class="btn primary" @onclick="AutoPlace">Auto-deploy fleet</button>
            <button type="button" class="btn ghost" @onclick="Reset">Reset</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="notice" role="status">@Message</p>
    }

    <div class="placement-guide">
        <div>
            <span class="guide-label">@(Mode == PlacementMode.Manual ? "Selected ship" : "Quick setup")</span>
            <strong>@GuideTitle</strong>
            <span class="subtle">@GuideCopy</span>
        </div>
        @if (Mode == PlacementMode.Manual)
        {
            <span class="orientation-chip">@(Horizontal ? "↔ Horizontal" : "↕ Vertical")</span>
        }
    </div>

    <div class="placement-grid">
        <BoardGrid Cells="@BoardView.Placement(Board)"
                   Interactive="true"
                   Label="Fleet placement board"
                   OnActivate="PlaceAt"
                   OnRotate="RotateAsync"
                   OnDrop="DropAt" />

        <div class="fleet-cards" aria-label="Ships to place">
            @foreach (var ship in Fleet.Ships)
            {
                var placed = Board.IsPlaced(ship.Kind);
                var selected = SelectedKind == ship.Kind;
                var canDrag = Mode == PlacementMode.Manual && !placed;
                <button type="button"
                        class="ship-card @(placed ? "placed" : string.Empty) @(selected ? "selected" : string.Empty)"
                        draggable="@(canDrag ? "true" : "false")"
                        data-ship="@ship.Kind"
                        aria-pressed="@selected"
                        disabled="@placed"
                        title="@(placed ? $"{ship.Name} is placed" : $"Select {ship.Name}")"
                        @ondragstart="() => OnDragStart(ship.Kind)"
                        @ondragend="() => _draggedKind = null"
                        @onclick="() => SelectShip(ship.Kind)">
                    <span class="ship-name">@ship.Name</span>
                    <span class="ship-size" aria-hidden="true">@(new string('■', ship.Size))</span>
                    <span class="ship-state">@(placed ? "Placed" : selected ? "Selected" : "Ready to place")</span>
                </button>
            }
        </div>
    </div>
</div>

@code {
    private enum PlacementMode
    {
        Manual,
        Automatic
    }

    private readonly Random _random = new();
    private PlacementMode _mode = PlacementMode.Manual;
    private ShipKind? _draggedKind;
    private ShipKind? _selectedKind;

    [Parameter, EditorRequired] public Board Board { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private PlacementMode Mode
    {
        get => _mode;
        set
        {
            _mode = value;
            Message = null;
        }
    }

    private bool Horizontal { get; set; } = true;
    private string? Message { get; set; }

    private ShipKind? SelectedKind =>
        _selectedKind is { } kind && !Board.IsPlaced(kind)
            ? kind
            : Fleet.Ships.FirstOrDefault(ship => !Board.IsPlaced(ship.Kind))?.Kind;

    private string GuideTitle => Mode == PlacementMode.Automatic
        ? "Deploy the whole fleet in one click"
        : SelectedKind is { } kind
            ? Fleet.NameOf(kind)
            : "Fleet ready";

    private string GuideCopy => Mode == PlacementMode.Automatic
        ? "The chart room places all five ships. Switch to Manual to adjust them."
        : SelectedKind is null
            ? "All five ships are placed. Start the battle when you are ready."
            : "Click or tap a cell, drag a ship card, or use the arrow keys and R to rotate.";

    private void OnDragStart(ShipKind kind)
    {
        if (Board.IsPlaced(kind))
        {
            return;
        }

        _selectedKind = kind;
        _draggedKind = kind;
    }

    private void SelectShip(ShipKind kind)
    {
        if (Mode != PlacementMode.Manual)
        {
            Mode = PlacementMode.Manual;
        }

        if (Board.IsPlaced(kind))
        {
            Message = $"{Fleet.NameOf(kind)} is already placed.";
            return;
        }

        _selectedKind = kind;
        Message = $"{Fleet.NameOf(kind)} selected. Choose a starting cell.";
    }

    private async Task PlaceAt(Coordinate coordinate)
    {
        if (Mode != PlacementMode.Manual)
        {
            Message = "Switch to Manual placement to place ships by hand.";
            return;
        }

        if (SelectedKind is not { } kind)
        {
            Message = "All five ships are placed. Start the battle when you are ready.";
            return;
        }

        if (Board.TryPlace(kind, coordinate, Horizontal))
        {
            Message = $"{Fleet.NameOf(kind)} placed at {coordinate.Label}.";
            _selectedKind = null;
            await NotifyAsync();
        }
        else
        {
            Message = "That placement is outside the board or overlaps another ship.";
        }
    }

    private async Task DropAt(Coordinate coordinate)
    {
        if (_draggedKind is not ShipKind kind)
        {
            return;
        }

        if (Mode != PlacementMode.Manual)
        {
            Message = "Switch to Manual placement to drag ships.";
            return;
        }

        if (Board.IsPlaced(kind))
        {
            Message = $"{Fleet.NameOf(kind)} is already placed.";
        }
        else if (Board.TryPlace(kind, coordinate, Horizontal))
        {
            Message = $"{Fleet.NameOf(kind)} dropped at {coordinate.Label}.";
            _selectedKind = null;
            await NotifyAsync();
        }
        else
        {
            Message = "That placement is outside the board or overlaps another ship.";
        }

        _draggedKind = null;
    }

    private async Task AutoPlace()
    {
        Message = Board.TryAutoPlaceAll(_random)
            ? "Fleet deployed automatically. Start the battle when ready."
            : "Automatic placement failed; try again or place the ships manually.";
        _selectedKind = null;
        await NotifyAsync();
    }

    private async Task Reset()
    {
        Board.Clear();
        _draggedKind = null;
        _selectedKind = null;
        Message = "Fleet cleared.";
        await NotifyAsync();
    }

    private async Task RotateAsync()
    {
        Rotate();
        await Task.CompletedTask;
    }

    private void Rotate()
    {
        Horizontal = !Horizontal;
        Message = $"Orientation: {(Horizontal ? "horizontal" : "vertical")}.";
    }

    private async Task NotifyAsync()
    {
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }
}
