@* Help.razor *@
@page "/help"
@using System.Text.Json.Nodes
@inject NavigationManager Navigation

<SeoMeta Title="How to Play Battleship — Rules, Controls & FAQ"
         Description="Battleship rules, fleet sizes, mouse, touch and keyboard controls, how the easy, medium and hard AI work, and how to play a friend online with a room code."
         Path="/help"
         JsonLd="@FaqJsonLd" />

<section class="page help-page">
    <header class="page-header">
        <div>
            <p class="eyebrow">Field manual</p>
            <h1>How to play</h1>
        </div>
        <button class="btn ghost" type="button" @onclick="GoMenu">Menu</button>
    </header>

    <div class="help-grid">
        <article class="panel">
            <h2>Rules</h2>
            <ul>
                <li>Each side has a 10×10 board and five ships.</li>
                <li>The fleet is Carrier (5), Battleship (4), Cruiser (3), Submarine (3), and Patrol Boat (2).</li>
                <li>Ships may not overlap or extend outside the board.</li>
                <li>Players alternate turns. A miss, hit, or sunk ship passes the turn.</li>
                <li>Repeated or invalid shots are rejected and do not use a turn.</li>
                <li>The first fleet to lose all five ships loses the game.</li>
            </ul>
        </article>

        <article class="panel">
            <h2>Controls</h2>
            <ul>
                <li><strong>Mouse:</strong> click a cell to place a ship or fire.</li>
                <li><strong>Touch:</strong> tap a cell or a ship card.</li>
                <li><strong>Drag:</strong> drag a ship card onto the placement board.</li>
                <li><strong>Keyboard:</strong> arrow keys move the cursor, <kbd>R</kbd> rotates, and <kbd>Enter</kbd> or <kbd>Space</kbd> activates the focused cell.</li>
            </ul>
        </article>

        <article class="panel">
            <h2>Difficulty</h2>
            <ul>
                <li><strong>Easy</strong> chooses uniformly at random among untried cells.</li>
                <li><strong>Medium</strong> hunts randomly, then targets cells adjacent to unresolved hits and extends along aligned hits.</li>
                <li><strong>Hard</strong> enumerates legal placements for the remaining fleet, weights those covering unresolved hits, and fires at the highest-scoring untried cell.</li>
            </ul>
            <p class="subtle">Every difficulty places its ships automatically. The AI never sees your hidden ship positions.</p>
        </article>

        <article class="panel">
            <h2>Multiplayer</h2>
            <ol>
                <li>Open <strong>Host</strong> and wait for a room code.</li>
                <li>Share the join link or read the six-character code to your opponent.</li>
                <li>Your opponent opens <strong>Join</strong>, enters the code, and connects.</li>
                <li>Place your fleets, press <strong>Ready</strong>, and the host fires first.</li>
                <li>Use the chat box at any time; chatting never changes whose turn it is.</li>
            </ol>
            <p class="subtle">Your unhit ship positions stay in your browser and are never sent to the server or your opponent.</p>
        </article>
    </div>

    <section class="panel faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        @foreach (var faq in Faqs)
        {
            <div class="faq-item">
                <h3>@faq.Question</h3>
                <p>@faq.Answer</p>
            </div>
        }
        <p class="subtle">
            Read the code, report issues or contribute on
            <a href="@SeoInfo.RepositoryUrl" target="_blank" rel="noopener">GitHub</a>.
        </p>
    </section>
</section>

@code {
    private sealed record Faq(string Question, string Answer);

    private static readonly Faq[] Faqs =
    {
        new("Is this Battleship game free to play?",
            "Yes. It is free, runs entirely in your web browser, and needs no download or sign-up."),
        new("Can I play Battleship against the computer?",
            "Yes. Choose Single player, pick easy, medium or hard, place your five ships, and fire at the AI's board. The AI only knows the results of its own shots."),
        new("What is the difference between easy, medium and hard?",
            "Easy fires at random untried cells. Medium hunts at random, then follows up on hits until the ship sinks. Hard counts every legal placement of the remaining fleet and fires at the most probable cell."),
        new("How do I play Battleship online with a friend?",
            "Choose Host a game to get a six-character room code, then share the join link or code. Your friend enters the code on the home page, both of you place your fleets and press Ready, and the host fires first."),
        new("Which ships are in the fleet?",
            "Five ships on a 10×10 board: Carrier (5 cells), Battleship (4), Cruiser (3), Submarine (3) and Patrol Boat (2)."),
        new("Does a hit give me another turn?",
            "No. Turns always alternate, whether the shot misses, hits or sinks a ship. Repeated or invalid shots are rejected and do not use your turn."),
        new("Can my opponent or the server see where my ships are?",
            "No. Your unhit ship positions stay in your browser. Only the result of each shot is shared."),
        new("Does it work on phones and with a keyboard?",
            "Yes. You can tap cells and ship cards on touch screens, drag ships with a mouse, or use the arrow keys, R to rotate, and Enter or Space to place and fire."),
        new("Is the source code available?",
            "Yes. Battleship is open source and written in C# with Blazor WebAssembly. The code is on GitHub at github.com/DocDBrown/BattleshipC-WebGame-.")
    };

    private static readonly string FaqJsonLd = SeoInfo.ToJsonLd(new JsonObject
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = new JsonArray(Faqs.Select(f => (JsonNode?)new JsonObject
        {
            ["@type"] = "Question",
            ["name"] = f.Question,
            ["acceptedAnswer"] = new JsonObject
            {
                ["@type"] = "Answer",
                ["text"] = f.Answer
            }
        }).ToArray())
    });

    private void GoMenu() => Navigation.NavigateTo("/");
}