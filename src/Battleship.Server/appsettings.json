{
  "Urls": "http://localhost:8080",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Battleship": {
    "MaxRooms": 500,
    "RoomCodeAttempts": 64,
    "CreateRoomPermitsPerMinute": 30,
    "ConnectPermitsPerMinute": 120,
    "KeepAliveSeconds": 30,
    "SendTimeoutSeconds": 5,
    "MessagesPerSecond": 10,
    "MessageBurst": 20,
    "ReaperIntervalSeconds": 30,
    "RoomIdleTimeoutSeconds": 120,
    "RoomMaxLifetimeMinutes": 60
  }
}
